# Runtime only. No cloud AI fallback; the separate Brev session supplies endpoints.
BUTTERFLY_DATA_DIR=data/runtime
BUTTERFLY_CORS_ORIGINS=
BUTTERFLY_SECURE_COOKIE=false
BUTTERFLY_COOKIE_SAMESITE=lax
# Empty selects .venv/Scripts/python.exe on Windows or .venv/bin/python on Unix.
BUTTERFLY_EXPORT_PYTHON=
# Existing HackAlem checkout with bin/hackalem-mcp and bin/hackalem-demo-api (.exe on Windows).
HACKALEM_HOME=
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
NEMOTRON_API_KEY=
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
# Existing Brev runtime: addresses below must point to services reachable from this backend.
RIVA_ASR_ENDPOINT=
# Set this only when the Riva SDK uses a different Python environment.
RIVA_PYTHON=
ASR_LANGUAGE=ru-RU
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
BUTTERFLY_PUBLIC_URL=http://127.0.0.1:8000
